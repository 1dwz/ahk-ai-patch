diff --git a/source/AutoHotkey.cpp b/source/AutoHotkey.cpp
index 02936c36..1192ad8e 100644
--- a/source/AutoHotkey.cpp
+++ b/source/AutoHotkey.cpp
@@ -130,6 +130,25 @@ ResultType ParseCmdLineArgs(LPTSTR &script_filespec)
 			g_script.mIsRestart = true;
 		else if (!_tcsicmp(param, _T("/force")))
 			g_ForceLaunch = true;
+		else if (!_tcsicmp(param, _T("/AI")) || !_tcsicmp(param, _T("/NonInteractive")))
+		{
+			// AutoHotkey.exe is a Windows GUI subsystem binary, so when it is started
+			// from a console without redirection it does NOT inherit that console
+			// and GetStdHandle(STD_ERROR_HANDLE) yields a handle nobody can see.
+			// Diagnostics were therefore discarded in exactly the case this switch
+			// exists for: a human (or agent) running `AutoHotkey.exe /AI script.ahk`
+			// in a terminal with no 2> redirection.  Attaching to the parent
+			// console makes stderr visible again.  It fails harmlessly (returns 0)
+			// when there is no parent console, e.g. under a service or a GUI
+			// launcher, and it does not disturb an already-valid redirected handle.
+			if (!AttachConsole(ATTACH_PARENT_PROCESS))
+			{
+				// Fall back to the console of this process, if any.
+				AttachConsole(GetCurrentProcessId());
+			}
+			g_script.SetNonInteractive();
+			g_script.SetErrorStdOut(NULL);
+		}
 #ifndef AUTOHOTKEYSC // i.e. the following switch is recognized only by AutoHotkey.exe (especially since recognizing new switches in compiled scripts can break them, unlike AutoHotkey.exe).
 		else if (!_tcsicmp(param, _T("/script")))
 			script_filespec = NULL; // Override compiled script mode, otherwise no effect.
@@ -221,10 +240,20 @@ ResultType CheckPriorInstance()
 			if (g_AllowOnlyOneInstance == SINGLE_INSTANCE_IGNORE)
 				return EARLY_EXIT;
 			if (g_AllowOnlyOneInstance != SINGLE_INSTANCE_REPLACE)
+			{
+				if (g_script.mNonInteractive)
+				{
+					// A prompt would block forever with no user.  #SingleInstance Prompt
+					// (the default) must be treated as "ignore" in non-interactive mode.
+					g_script.PrintDiagnostic(_T("Another instance of this script is already running.  ")
+						_T("Exiting this instance instead of prompting (#SingleInstance)."), _T(""), WARN, nullptr, nullptr);
+					return EARLY_EXIT;
+				}
 				if (MsgBox(_T("An older instance of this script is already running.  Replace it with this")
 					_T(" instance?\nNote: To avoid this message, see #SingleInstance in the help file.")
 					, MB_YESNO, g_script.mFileName) == IDNO)
 					return EARLY_EXIT;
+			}
 			// Otherwise:
 			reason_to_close_prior = AHK_EXIT_BY_SINGLEINSTANCE;
 		}
@@ -255,6 +284,11 @@ ResultType CheckPriorInstance()
 				// This can happen if the previous instance has an OnExit function that takes a long
 				// time to finish, or if it's waiting for a network drive to timeout or some other
