+// ahk-ai patch: emit the built-in function table in a stable, line-oriented
+// format and exit.  One record per line, tab separated:
+//
+//   NAME <tab> MIN <tab> MAX <tab> VARIADIC <tab> OUTPUTS
+//
+// MAX is reported as "variadic" when the function accepts unlimited
+// arguments, and OUTPUTS is a comma-separated list of 1-based parameter
+// indices that are output variables (empty when there are none).  This mirrors
+// what the interpreter itself enforces, because it is read from the same
+// g_BIF table that Script::GetBuiltInFunc() searches.
+//
+// Deliberately writes ANSI/UTF-8 bytes straight to the standard handle rather
+// than going through the script's own diagnostic machinery: /dump-api must
+// work before any script is loaded, and its output is meant to be parsed.
+void DumpBuiltinApi()
+{
+	HANDLE hOut = GetStdHandle(STD_OUTPUT_HANDLE);
+	if (hOut == INVALID_HANDLE_VALUE || hOut == nullptr)
+		return;
+
+	// Set to UTF-8 so function names and any future descriptions survive
+	// redirection into a file on any system codepage.
+	SetConsoleOutputCP(CP_UTF8);
+
+	// CStringA holds bytes; each piece is converted from the TCHAR source with
+	// CStringUTF8FromWChar (the only UTF-8-producing type in StringConv.h).
+	// The literals must be _T() since TCHAR is wchar_t in a Unicode build.
+	CStringA buffer;
+	{
+		CStringUTF8FromWChar u(_T("# AutoHotkey built-in functions\n"));
+		buffer.Append(u);
+	}
+	{
+		CStringUTF8FromWChar u(_T("# name\tmin\tmax\tvariadic\toutputs\n"));
+		buffer.Append(u);
+		CStringUTF8FromWChar u2(_T("# max is '*' when the function is variadic\n"));
+		buffer.Append(u2);
+	}
+
+	int count = Script::BuiltinApiCount();
+	for (int i = 0; i < count; ++i)
+	{
+		const BuiltinApiFunc &e = Script::BuiltinApiAt(i);
+
+		CStringUTF8FromWChar uName(e.name);
+		char line[512];
+		sprintf(line, "%s\t%d\t%s\t%d\t", uName.GetString(), e.minParams
+			, e.variadic ? "*" : ""
+			, e.variadic ? 1 : 0);
+		buffer.Append(line);
+
+		// mOutputVars is a zero-terminated list of 1-based indices.
+		for (int v = 0; v < e.outputCount; ++v)
+		{
+			char num[16];
+			sprintf(num, v ? ",%d" : "%d", (int)e.outputs[v]);
+			buffer.Append(num);
+		}
+		buffer.Append("\n");
+	}
+
+	// Second section: the typed registry from lib/functions.h.  This is where
+	// the argument types live, so it is what lets a caller build a correct
+	// call instead of guessing from the parameter count.
+	{
+		CStringUTF8FromWChar u(_T("\n# typed functions (lib/functions.h)\n"));
+		buffer.Append(u);
+		CStringUTF8FromWChar u2(_T("# name\treturn\targs (comma separated, in order)\n"));
+		buffer.Append(u2);
+	}
+
+	int mdCount = Script::MdFuncApiCount();
+	for (int i = 0; i < mdCount; ++i)
+	{
+		int argCount = 0, retType = 0;
+		int *argTypes = nullptr;
+		LPCTSTR name = Script::MdFuncApiAt(i, argCount, argTypes, retType);
+		CStringUTF8FromWChar uName(name);
+
+		char line[4096];
+		sprintf(line, "%s\t", uName.GetString());
+		buffer.Append(line);
+
+		// Render one parameter per argument.  argtype[] stores modifiers as
+		// separate elements that apply to the *next* type, so they are
+		// accumulated and merged here -- otherwise the output reads
+		// "In_Opt, In String" instead of "In_Opt String", which is not how
+		// the source spells it and would mislead a reader.
+		bool first = true;
+		CStringA pending;
+		for (int a = 0; a < argCount; ++a)
+		{
+			int code = argTypes[a];
+			// Modifiers are >= MdType::FirstModifier (Optional = 0x80).
+			if (code >= (int)0x80)
+			{
+				CStringUTF8FromWChar uMod(Script::MdTypeToString(code));
+				if (pending.GetLength())
+					pending.Append("_");
+				pending.Append(uMod.GetString());
+				continue;
+			}
+			CStringUTF8FromWChar uType(Script::MdTypeToString(code));
+			sprintf(line, "%s%s%s", first ? "" : ", ", pending.GetString()
+				, pending.GetLength() ? " " : "");
+			buffer.Append(line);
+			buffer.Append(uType.GetString());
+			pending.Empty();
+			first = false;
+		}
+		buffer.Append("\n");
+	}
+
+	DWORD written = 0;
+	WriteFile(hOut, buffer.GetString(), (DWORD)buffer.GetLength(), &written, nullptr);
+}
