+// ahk-ai patch: /dump-api entry points.  g_BIF is file-local, so callers
+// elsewhere (AutoHotkey.cpp) go through these two accessors instead of
+// duplicating or re-declaring the table.
+int Script::BuiltinApiCount()
+{
+	return _countof(g_BIF);
+}
+
+const BuiltinApiFunc &Script::BuiltinApiAt(int aIndex)
+{
+	// A single shared view is enough: /dump-api reads one entry at a time and
+	// there is no concurrency to worry about during command-line parsing.
+	static BuiltinApiFunc sView;
+	FuncEntry &e = g_BIF[aIndex];
+	sView.name = e.mName;
+	sView.minParams = (int)e.mMinParams;
+	// MAX_FUNCTION_PARAMS marks an unlimited maximum; BuiltInFunc's constructor
+	// uses the same test when it sets mIsVariadic.
+	sView.variadic = (e.mMaxParams == MAX_FUNCTION_PARAMS);
+	sView.outputCount = 0;
+	for (int v = 0; v < MAX_FUNC_OUTPUT_VAR && e.mOutputVars[v]; ++v)
+	{
+		sView.outputs[sView.outputCount++] = e.mOutputVars[v];
+	}
+	return sView;
+}
+
 
