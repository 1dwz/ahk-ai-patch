+// Writes a diagnostic straight to the process's stderr handle.
+//
+// Deliberately avoids TextFile/TextStream: opening "**" with APPEND remaps the
+// access mode to READ internally (see TextFile::Open), which leaves the stream
+// in read mode so buffered writes are never flushed. The net effect was that
+// /AI diagnostics were silently discarded whenever stderr was a pipe or a
+// redirected file (e.g. PowerShell, or `2>err.txt`), even though they appeared
+// to work in a plain console.
+void Script::WriteDiagnosticRaw(LPCTSTR aText, int aLength)
+{
+	if (!aText || !*aText)
+		return;
+	if (aLength < 0)
+		aLength = (int)_tcslen(aText);
+	if (!aLength)
+		return;
+
+	HANDLE h = GetStdHandle(STD_ERROR_HANDLE);
+	if (!h || h == INVALID_HANDLE_VALUE)
+		return;
+
+	DWORD written = 0;
+	// WriteFile handles disk/pipe handles; WriteConsoleW is required for a real
+	// console when the buffer contains non-ASCII (WriteFile would garble it).
+	DWORD ft = GetFileType(h);
+	if (ft == FILE_TYPE_CHAR)
+	{
+		// Console: write UTF-16 (wchar_t) directly.
+		WriteConsoleW(h, aText, (DWORD)aLength, &written, nullptr);
+	}
+	else
+	{
+#ifdef UNICODE
+		// Non-console: convert to UTF-8 so redirected/piped output is readable.
+		int need = WideCharToMultiByte(CP_UTF8, 0, aText, aLength, nullptr, 0, nullptr, nullptr);
+		if (need > 0)
+		{
+			char *utf8 = (char *)malloc(need + 1);
+			if (utf8)
+			{
+				WideCharToMultiByte(CP_UTF8, 0, aText, aLength, utf8, need, nullptr, nullptr);
+				utf8[need] = '\0';
+				DWORD n = (DWORD)need, off = 0;
+				while (off < n)
+				{
+					DWORD chunk = 0;
+					if (!WriteFile(h, utf8 + off, n - off, &chunk, nullptr) || !chunk)
+						break;
+					off += chunk;
+				}
+				free(utf8);
+			}
+		}
+#else
+		DWORD n = (DWORD)aLength, off = 0;
+		while (off < n)
+		{
+			DWORD chunk = 0;
+			if (!WriteFile(h, aText + off, n - off, &chunk, nullptr) || !chunk)
+				break;
+			off += chunk;
+		}
+#endif
+	}
+	FlushFileBuffers(h);
+}
