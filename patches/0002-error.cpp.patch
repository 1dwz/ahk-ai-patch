+void Script::PrintDiagnostic(LPCTSTR aErrorText, LPCTSTR aExtraInfo, ResultType aErrorType, Line *aLine, Object *aException)
+{
+	// Record that this process produced a real (non-warning) diagnostic.  The
+	// auto-exec section and the startup path consult this flag to pick a
+	// non-zero process exit code, because g->ThrownToken has usually already
+	// been released by the time control returns to them.
+	if (aErrorType != WARN)
+	{
+		mNonInteractiveErrorSeen = true;
+		// TerminateApp() (via ExitApp) reads mPendingExitCode, which defaults to
+		// 0.  Without this, a script whose thread dies from an unhandled error
+		// would still report success to the shell.
+		if (mPendingExitCode == 0)
+			mPendingExitCode = EXIT_ERROR;
+	}
+	if (!aErrorText)
+		aErrorText = _T("");
+	if (!aExtraInfo)
+		aExtraInfo = _T("");
+	FileIndexType file_index = aLine ? aLine->mFileIndex : mCurrFileIndex;
+	LineNumberType line_number = aLine ? aLine->mLineNumber : (mCombinedLineNumber ? mCombinedLineNumber : CurrentLine());
+	TCHAR buf[LINE_SIZE * 2];
+	int n = FormatStdErr(buf, _countof(buf), aErrorText, aExtraInfo, file_index, line_number, aErrorType == WARN);
+	if (aException)
+	{
+		LPCTSTR file = aException->GetOwnPropString(_T("File"));
+		LineNumberType line = (LineNumberType)aException->GetOwnPropInt64(_T("Line"));
+		if (file && *file)
+			n += sntprintf(buf + n, _countof(buf) - n, _T("File: %s\nLine: %u\n"), file, line);
+	}
+	PrintErrorStdOut(buf, n, _T("**"));
+}
