diff --git a/source/lib/http_builtin.cpp b/source/lib/http_builtin.cpp
new file mode 100644
index 00000000..469b883e
--- /dev/null
+++ b/source/lib/http_builtin.cpp
@@ -0,0 +1,628 @@
+/*#########################################################################
+# AHK-AI patch: built-in HTTP support (libcurl)
+#
+# Adds one built-in function to AutoHotkey v2:
+#
+#   HttpRequest(url [, options]) -> Map
+#
+# options (all optional, Map keys are case-sensitive):
+#   Method             "GET" (default), "POST", "PUT", "PATCH", "DELETE", "HEAD"
+#   Body               request body as a string (implies POST unless Method set)
+#   Headers            Map of name -> value, or an Array of "Name: value"
+#   Timeout            total timeout in seconds (default 30)
+#   ConnectTimeout     connection timeout in seconds (default 10)
+#   FollowRedirects    true/false (default true)
+#   MaxRedirects       default 10
+#   UserAgent          default "AutoHotkey/2.1 (ahk-ai)"
+#   ContentType        convenience for the Content-Type header
+#   Insecure           true to skip TLS verification (default false)
+#   Proxy              proxy URL, e.g. "http://127.0.0.1:8080"
+#   SaveTo             file path; the body is written there (UTF-8) instead
+#                      of being returned in Body
+#
+# Returns a Map with:
+#   Status        HTTP status code (Integer; 0 on transport failure)
+#   StatusText    reason phrase, or "" (libcurl does not expose it)
+#   Ok            true when 200 <= Status < 300
+#   Headers       Map of lower-cased name -> value; repeated names such as
+#                 "set-cookie" collect into an Array
+#   Body          response body as a string (UTF-8 decoded)
+#   BodyBytes     body size in bytes (Integer)
+#   Url           the final URL after redirects
+#   ElapsedMs     total time in milliseconds
+#   Error         present only when the request failed at the transport level
+#
+# libcurl is linked statically (Schannel backend, HTTP/HTTPS only), so a
+# single AutoHotkey64.exe is self-contained and needs no external DLL.
+# third_party/curl-static/ holds the import-able static library; see
+# tools/build-libcurl-static.ps1 for how it is produced.
+#########################################################################*/
+
+#include "stdafx.h"
+#include "script.h"
+#include "script_func_impl.h"
+#include "globaldata.h"
+#include "StringConv.h"
+
+// libcurl's own headers. CURLOPT_* / CURLINFO_* come from here so the option
+// numbers can never drift from the library they are passed to.
+#define CURL_STATICLIB
+#include <curl/curl.h>
+
+// --- libcurl entry points we need -----------------------------------------
+// With a static link these are plain declarations resolved by the linker; the
+// function pointers below simply point at them, which keeps the ~60 call sites
+// in this file written as `g_curl.xxx(...)` and so unchanged.
+
+// --- curl_easy_setopt option codes ---------------------------------------
+// These now come from libcurl's own headers, which removes a whole class of
+// silent breakage: a wrong option number is accepted by curl_easy_setopt and
+// only misbehaves later, so hand-written constants are not worth the risk.
+// The trailing-underscore aliases are kept so the long list of existing call
+// sites stays readable and unchanged.
+#define CURLOPT_WRITEDATA_       CURLOPT_WRITEDATA
+#define CURLOPT_URL_             CURLOPT_URL
+#define CURLOPT_PROXY_           CURLOPT_PROXY
+#define CURLOPT_WRITEFUNCTION_   CURLOPT_WRITEFUNCTION
+#define CURLOPT_HTTPHEADER_      CURLOPT_HTTPHEADER
+#define CURLOPT_HEADERFUNCTION_  CURLOPT_HEADERFUNCTION
+#define CURLOPT_HEADERDATA_      CURLOPT_HEADERDATA
+#define CURLOPT_TIMEOUT_         CURLOPT_TIMEOUT
+#define CURLOPT_CONNECTTIMEOUT_  CURLOPT_CONNECTTIMEOUT
+#define CURLOPT_FOLLOWLOCATION_  CURLOPT_FOLLOWLOCATION
+#define CURLOPT_MAXREDIRS_       CURLOPT_MAXREDIRS
+#define CURLOPT_USERAGENT_       CURLOPT_USERAGENT
+#define CURLOPT_POSTFIELDS_      CURLOPT_POSTFIELDS
+#define CURLOPT_POSTFIELDSIZE_   CURLOPT_POSTFIELDSIZE
+#define CURLOPT_CUSTOMREQUEST_   CURLOPT_CUSTOMREQUEST
+#define CURLOPT_SSL_VERIFYPEER_  CURLOPT_SSL_VERIFYPEER
+#define CURLOPT_SSL_VERIFYHOST_  CURLOPT_SSL_VERIFYHOST
+#define CURLOPT_CAINFO_          CURLOPT_CAINFO
+#define CURLOPT_NOSIGNAL_        CURLOPT_NOSIGNAL
+#define CURLOPT_ACCEPT_ENCODING_ CURLOPT_ACCEPT_ENCODING
+#define CURLOPT_POST_            CURLOPT_POST
+#define CURLOPT_NOBODY_          CURLOPT_NOBODY
+#define CURLOPT_HTTPGET_         CURLOPT_HTTPGET
+
+#define CURLINFO_RESPONSE_CODE_  CURLINFO_RESPONSE_CODE
+#define CURLINFO_EFFECTIVE_URL_  CURLINFO_EFFECTIVE_URL
+#define CURLINFO_TOTAL_TIME_     CURLINFO_TOTAL_TIME
+
+#define CURLE_OK_ CURLE_OK
+
+// --- statically linked libcurl -------------------------------------------
+// The static library is linked in, so the pointers below are simply filled
+// with the real addresses. Keeping them behind a struct means the ~60 call
+// sites did not have to change when this moved off LoadLibrary/GetProcAddress.
+struct CurlApi
+{
+	bool ok = false;
+	// These signatures come from libcurl's headers rather than being spelled
+	// out by hand, so the compiler checks them against the real functions.
+	CURL *(*easy_init)()                                      = nullptr;
+	CURLcode (*easy_setopt)(CURL *, CURLoption, ...)          = nullptr;
+	CURLcode (*easy_perform)(CURL *)                          = nullptr;
+	CURLcode (*easy_getinfo)(CURL *, CURLINFO, ...)           = nullptr;
+	void (*easy_cleanup)(CURL *)                              = nullptr;
+	curl_slist *(*slist_append)(curl_slist *, const char *)   = nullptr;
+	void (*slist_free_all)(curl_slist *)                      = nullptr;
+	const char *(*easy_strerror)(CURLcode)                    = nullptr;
+	// Path of the CA bundle used when libcurl's own default is not enough.
+	// With Schannel this is normally empty: Windows verifies against its own
+	// trust store, so no bundle needs to ship at all.
+	char ca_path[MAX_PATH] = "";
+};
+
+static CurlApi g_curl;
+
+// Directory containing the running interpreter, with a trailing backslash.
+static void GetExeDir(TCHAR *aBuf, size_t aBufCount)
+{
+	aBuf[0] = '\0';
+	TCHAR dir[MAX_PATH];
+	DWORD n = GetModuleFileName(g_hInstance, dir, _countof(dir));
+	if (!n || n >= _countof(dir))
+		return;
+	LPTSTR slash = _tcsrchr(dir, '\\');
+	if (slash)
+		*(slash + 1) = '\0';
+	// sntprintf takes an int size, and MAX_PATH always fits.
+	sntprintf(aBuf, (int)aBufCount, _T("%s"), dir);
+}
+
+// Fill in the table once. Thread-safe via a function-local static, which the
+// C++ runtime guarantees is initialised exactly once even under contention.
+static bool EnsureCurl()
+{
+	static bool initialised = []() -> bool {
+		CURLcode globalInit = curl_global_init(CURL_GLOBAL_DEFAULT);
+		if (globalInit != CURLE_OK)
+			return false;
+
+		g_curl.easy_init      = &curl_easy_init;
+		g_curl.easy_setopt    = &curl_easy_setopt;
+		g_curl.easy_perform   = &curl_easy_perform;
+		g_curl.easy_getinfo   = &curl_easy_getinfo;
+		g_curl.easy_cleanup   = &curl_easy_cleanup;
+		g_curl.slist_append   = &curl_slist_append;
+		g_curl.slist_free_all = &curl_slist_free_all;
+		g_curl.easy_strerror  = &curl_easy_strerror;
+
+		// Schannel uses the Windows trust store. Only honour an explicit bundle
+		// if one was placed next to the interpreter, which lets a user pin a
+		// private CA without rebuilding.
+		TCHAR dir[MAX_PATH];
+		GetExeDir(dir, _countof(dir));
+		if (dir[0])
+		{
+			TCHAR ca[MAX_PATH];
+			sntprintf(ca, _countof(ca), _T("%scurl\\curl-ca-bundle.crt"), dir);
+			if (GetFileAttributes(ca) != INVALID_FILE_ATTRIBUTES)
+			{
+				CStringUTF8FromWChar utf8(ca);
+				sprintf(g_curl.ca_path, "%s", (LPCSTR)utf8);
+			}
+		}
+
+		g_curl.ok = true;
+		return true;
+	}();
+
+	return initialised;
+}
+
+// --- response accumulation ------------------------------------------------
+struct HttpBuffer
+{
+	char *data = nullptr;   // raw bytes, NUL-terminated
+	size_t len = 0;
+	size_t cap = 0;
+
+	~HttpBuffer() { if (data) free(data); }
+};
+
+static size_t WriteBodyCallback(char *ptr, size_t size, size_t nmemb, void *userdata)
+{
+	auto *buf = static_cast<HttpBuffer *>(userdata);
+	size_t n = size * nmemb;
+	if (buf->len + n + 1 > buf->cap)
+	{
+		size_t ncap = buf->cap ? buf->cap : 4096;
+		while (ncap < buf->len + n + 1) ncap *= 2;
+		char *bigger = (char *)realloc(buf->data, ncap);
+		if (!bigger)
+			return 0; // signals an error to libcurl
+		buf->data = bigger;
+		buf->cap = ncap;
+	}
+	memcpy(buf->data + buf->len, ptr, n);
+	buf->len += n;
+	buf->data[buf->len] = '\0';
+	return n;
+}
+
+// Header lines arrive as "Name: value\r\n". Names are stored lower-cased.
+struct HeaderSink
+{
+	Map *headers = nullptr;
+};
+
+static size_t WriteHeaderCallback(char *ptr, size_t size, size_t nmemb, void *userdata)
+{
+	auto *sink = static_cast<HeaderSink *>(userdata);
+	size_t n = size * nmemb;
+	if (n > 5 && strncmp(ptr, "HTTP/", 5) && sink->headers)
+	{
+		const char *colon = (const char *)memchr(ptr, ':', n);
+		if (colon)
+		{
+			size_t nameLen = (size_t)(colon - ptr);
+			if (nameLen && nameLen < 256)
+			{
+				char name[256];
+				memcpy(name, ptr, nameLen);
+				name[nameLen] = '\0';
+				CharLowerA(name);
+
+				const char *val = colon + 1;
+				size_t maxVal = n - (size_t)(val - ptr);
+				while (maxVal && (*val == ' ' || *val == '\t')) { ++val; --maxVal; }
+				while (maxVal && (val[maxVal - 1] == '\r' || val[maxVal - 1] == '\n')) --maxVal;
+
+				CStringWCharFromUTF8 wname(name);
+				CStringWCharFromUTF8 wval(val, (int)maxVal);
+
+				// Repeated headers such as set-cookie collect into an Array.
+				ExprTokenType existing;
+				if (sink->headers->GetItem(existing, (LPTSTR)(LPCWSTR)wname))
+				{
+					if (existing.symbol == SYM_OBJECT && existing.object
+						&& existing.object->IsOfType(Array::sPrototype))
+					{
+						static_cast<Array *>(existing.object)->Append((LPTSTR)(LPCWSTR)wval);
+					}
+					else
+					{
+						Array *arr = Array::Create();
+						if (arr)
+						{
+							arr->Append(TokenToString(existing));
+							arr->Append((LPTSTR)(LPCWSTR)wval);
+							sink->headers->SetItem((LPTSTR)(LPCWSTR)wname, ExprTokenType(arr));
+						}
+					}
+				}
+				else
+					sink->headers->SetItem((LPTSTR)(LPCWSTR)wname, ExprTokenType((LPTSTR)(LPCWSTR)wval));
+			}
+		}
+	}
+	return n;
+}
+
+// --- option readers -------------------------------------------------------
+
+// Options may be given as a Map or as a plain object literal, since AHK v2.1
+// produces an Object for `{ Key: value }`. Own properties are read for the
+// Object form and Map items for the Map form, so both spellings work.
+static bool GetOpt(IObject *opts, LPCTSTR key, ExprTokenType &aOut)
+{
+	if (!opts)
+		return false;
+	if (opts->IsOfType(Map::sPrototype))
+		return static_cast<Map *>(opts)->GetItem(aOut, const_cast<LPTSTR>(key));
+	// A plain Object literal exposes its keys as own properties.
+	return static_cast<Object *>(opts)->GetOwnProp(aOut, const_cast<LPTSTR>(key));
+}
+
+// Map::SetItem takes ExprTokenType, so wrap the common value shapes.
+static void SetInt(Map *m, LPCTSTR key, __int64 v)
+{
+	if (m) m->SetItem(const_cast<LPTSTR>(key), ExprTokenType(v));
+}
+
+static void SetStr(Map *m, LPCTSTR key, LPCTSTR v)
+{
+	if (m) m->SetItem(const_cast<LPTSTR>(key), ExprTokenType(const_cast<LPTSTR>(v ? v : _T(""))));
+}
+
+static void SetObj(Map *m, LPCTSTR key, IObject *v)
+{
+	if (m && v) m->SetItem(const_cast<LPTSTR>(key), ExprTokenType(v));
+}
+static bool OptString(IObject *opts, LPCTSTR key, LPTSTR out, size_t outSize)
+{
+	ExprTokenType v;
+	if (!GetOpt(opts, key, v))
+		return false;
+	LPTSTR s = TokenToString(v);
+	sntprintf(out, (int)outSize, _T("%s"), s ? s : _T(""));
+	return true;
+}
+
+static bool OptPresent(IObject *opts, LPCTSTR key, ExprTokenType &aOut)
+{
+	return GetOpt(opts, key, aOut);
+}
+
+static __int64 OptInt(IObject *opts, LPCTSTR key, __int64 def)
+{
+	ExprTokenType v;
+	if (!GetOpt(opts, key, v))
+		return def;
+	return TokenToInt64(v);
+}
+
+static bool OptBool(IObject *opts, LPCTSTR key, bool def)
+{
+	ExprTokenType v;
+	if (!GetOpt(opts, key, v))
+		return def;
+	return TokenToInt64(v) != 0;
+}
+
+////////////////////////////////////////////////////////////////////////////
+// HttpRequest(url [, options])
+//
+BIF_DECL(BIF_HttpRequest)
+{
+	if (aParamCount < 1)
+	{
+		aResultToken.SetValue(_T(""));
+		return;
+	}
+
+	LPTSTR url = ParamIndexToString(0);
+	if (!url || !*url)
+		_f_throw_param(0, _T("a non-empty URL"));
+
+	IObject *opts = nullptr;
+	if (aParamCount >= 2)
+	{
+		// Accept both a Map and a plain Object literal as the options bag.
+		if (IObject *o = ParamIndexToObject(1))
+			opts = o;
+	}
+
+	if (!EnsureCurl())
+	{
+		// With a static link the only realistic cause is curl_global_init
+		// failing, typically because Windows could not set up winsock.
+		aResultToken.Error(_T("HttpRequest")
+			, _T("libcurl failed to initialise (curl_global_init). This usually")
+			  _T(" means the winsock stack is unavailable."));
+		return;
+	}
+
+	// --- read options -----------------------------------------------------
+	TCHAR method[16] = _T("GET");
+	bool methodWasGiven = OptString(opts, _T("Method"), method, _countof(method));
+	CharUpper(method);
+
+	ExprTokenType bodyTok;
+	bool hasBody = OptPresent(opts, _T("Body"), bodyTok);
+	LPTSTR body = hasBody ? TokenToString(bodyTok) : nullptr;
+
+	TCHAR saveTo[MAX_PATH] = _T("");
+	OptString(opts, _T("SaveTo"), saveTo, _countof(saveTo));
+
+	bool followRedirects = OptBool(opts, _T("FollowRedirects"), true);
+	__int64 timeout = OptInt(opts, _T("Timeout"), 30);
+	__int64 connectTimeout = OptInt(opts, _T("ConnectTimeout"), 10);
+	__int64 maxRedirects = OptInt(opts, _T("MaxRedirects"), 10);
+	bool insecure = OptBool(opts, _T("Insecure"), false);
+
+	TCHAR userAgent[256] = _T("AutoHotkey/2.1 (ahk-ai)");
+	OptString(opts, _T("UserAgent"), userAgent, _countof(userAgent));
+	TCHAR proxy[512] = _T("");
+	OptString(opts, _T("Proxy"), proxy, _countof(proxy));
+	TCHAR contentType[256] = _T("");
+	OptString(opts, _T("ContentType"), contentType, _countof(contentType));
+
+	// A body without an explicit Method implies POST, matching other clients.
+	if (hasBody && !methodWasGiven)
+		_tcsncpy(method, _T("POST"), _countof(method) - 1);
+
+	// --- build the header list (libcurl wants ANSI/UTF-8 strings) ---------
+	curl_slist *headerList = nullptr;
+	if (contentType[0])
+	{
+		TCHAR ct[512];
+		sntprintf(ct, _countof(ct), _T("Content-Type: %s"), contentType);
+		CStringUTF8FromWChar u(ct);
+		headerList = g_curl.slist_append(headerList, (LPCSTR)u);
+	}
+
+	ExprTokenType headersTok;
+	// A Map held in a variable arrives as SYM_VAR, not SYM_OBJECT, so testing the
+	// symbol directly silently skips the headers. Resolve the token to an
+	// IObject first; this is the same trap that JsonStringify hit.
+	if (OptPresent(opts, _T("Headers"), headersTok))
+	{
+		IObject *hobj = nullptr;
+		if (headersTok.symbol == SYM_VAR)
+		{
+			// VarRef: unwrap without taking a reference we would have to release.
+			ExprTokenType resolved;
+			headersTok.var->ToTokenSkipAddRef(resolved);
+			if (resolved.symbol == SYM_OBJECT)
+				hobj = resolved.object;
+		}
+		else if (headersTok.symbol == SYM_OBJECT)
+			hobj = headersTok.object;
+
+		if (hobj)
+		{
+		// Both a Map and a plain Object literal may carry the headers.
+		if (hobj->IsOfType(Map::sPrototype) || hobj->IsOfType(Object::sPrototype))
+		{
+			IObject *enumerator;
+			if (GetEnumerator(enumerator, ExprTokenType(hobj), 2, false) == OK)
+			{
+				auto vk = new VarRef(), vv = new VarRef();
+				ExprTokenType tp[] = { vk, vv }, *pp[] = { tp, tp + 1 };
+				while (CallEnumerator(enumerator, pp, 2, false) == CONDITION_TRUE)
+				{
+					ExprTokenType kt, vt;
+					vk->ToTokenSkipAddRef(kt);
+					vv->ToTokenSkipAddRef(vt);
+					TCHAR line[1024];
+					sntprintf(line, _countof(line), _T("%s: %s"), TokenToString(kt), TokenToString(vt));
+					CStringUTF8FromWChar u(line);
+					headerList = g_curl.slist_append(headerList, (LPCSTR)u);
+				}
+				// CallEnumerator hands back references we own; leaking them keeps
+				// the argument objects alive for the life of the process.
+				vk->Release();
+				vv->Release();
+				enumerator->Release();
+			}
+		}
+		else if (hobj->IsOfType(Array::sPrototype))
+		{
+			auto *arr = static_cast<Array *>(hobj);
+			for (UINT i = 0; i < (UINT)arr->Length(); ++i)
+			{
+				ExprTokenType item;
+				if (arr->ItemToToken(i, item))
+				{
+					CStringUTF8FromWChar u(TokenToString(item));
+					headerList = g_curl.slist_append(headerList, (LPCSTR)u);
+				}
+			}
+		}
+		}
+	}
+
+	// --- perform the request ----------------------------------------------
+	CURL *curl = g_curl.easy_init();
+	if (!curl)
+	{
+		if (headerList) g_curl.slist_free_all(headerList);
+		aResultToken.MemoryError();
+		return;
+	}
+
+	HttpBuffer buf;
+	HeaderSink sink;
+	Map *resultHeaders = Map::Create();
+	if (!resultHeaders)
+	{
+		g_curl.easy_cleanup(curl);
+		if (headerList) g_curl.slist_free_all(headerList);
+		aResultToken.MemoryError();
+		return;
+	}
+	sink.headers = resultHeaders;
+
+	CStringUTF8FromWChar uUrl(url);
+	CStringUTF8FromWChar uAgent(userAgent);
+
+	g_curl.easy_setopt(curl, CURLOPT_URL_, (LPCSTR)uUrl);
+	g_curl.easy_setopt(curl, CURLOPT_NOSIGNAL_, (long)1);
+	g_curl.easy_setopt(curl, CURLOPT_WRITEFUNCTION_, (void *)&WriteBodyCallback);
+	g_curl.easy_setopt(curl, CURLOPT_WRITEDATA_, &buf);
+	g_curl.easy_setopt(curl, CURLOPT_HEADERFUNCTION_, (void *)&WriteHeaderCallback);
+	g_curl.easy_setopt(curl, CURLOPT_HEADERDATA_, &sink);
+	g_curl.easy_setopt(curl, CURLOPT_FOLLOWLOCATION_, followRedirects ? 1L : 0L);
+	if (maxRedirects > 0)
+		g_curl.easy_setopt(curl, CURLOPT_MAXREDIRS_, (long)maxRedirects);
+	if (timeout > 0)
+		g_curl.easy_setopt(curl, CURLOPT_TIMEOUT_, (long)timeout);
+	if (connectTimeout > 0)
+		g_curl.easy_setopt(curl, CURLOPT_CONNECTTIMEOUT_, (long)connectTimeout);
+	if (userAgent[0])
+		g_curl.easy_setopt(curl, CURLOPT_USERAGENT_, (LPCSTR)uAgent);
+	if (proxy[0])
+	{
+		CStringUTF8FromWChar uProxy(proxy);
+		g_curl.easy_setopt(curl, CURLOPT_PROXY_, (LPCSTR)uProxy);
+	}
+	if (headerList)
+		g_curl.easy_setopt(curl, CURLOPT_HTTPHEADER_, headerList);
+	// Ask for transparent decompression; harmless if the server ignores it.
+	g_curl.easy_setopt(curl, CURLOPT_ACCEPT_ENCODING_, "");
+	if (g_curl.ca_path[0])
+		g_curl.easy_setopt(curl, CURLOPT_CAINFO_, g_curl.ca_path);
+	if (insecure)
+	{
+		g_curl.easy_setopt(curl, CURLOPT_SSL_VERIFYPEER_, 0L);
+		g_curl.easy_setopt(curl, CURLOPT_SSL_VERIFYHOST_, 0L);
+	}
+
+	// Body must outlive the perform call, so keep the UTF-8 form in scope.
+	CStringUTF8FromWChar uBody(body ? body : _T(""));
+	size_t bodyBytes = 0;
+	if (hasBody)
+	{
+		// Measure the UTF-8 length rather than the UTF-16 character count.
+		bodyBytes = strlen((LPCSTR)uBody);
+	}
+
+	if (!_tcscmp(method, _T("HEAD")))
+	{
+		g_curl.easy_setopt(curl, CURLOPT_NOBODY_, 1L);
+	}
+	else if (!_tcscmp(method, _T("GET")))
+	{
+		g_curl.easy_setopt(curl, CURLOPT_HTTPGET_, 1L);
+	}
+	else if (!_tcscmp(method, _T("POST")))
+	{
+		g_curl.easy_setopt(curl, CURLOPT_POST_, 1L);
+		if (hasBody)
+		{
+			g_curl.easy_setopt(curl, CURLOPT_POSTFIELDS_, (LPCSTR)uBody);
+			g_curl.easy_setopt(curl, CURLOPT_POSTFIELDSIZE_, (long)bodyBytes);
+		}
+	}
+	else
+	{
+		// PUT / PATCH / DELETE / any custom verb.
+		CStringUTF8FromWChar uMethod(method);
+		g_curl.easy_setopt(curl, CURLOPT_CUSTOMREQUEST_, (LPCSTR)uMethod);
+		if (hasBody)
+		{
+			g_curl.easy_setopt(curl, CURLOPT_POSTFIELDS_, (LPCSTR)uBody);
+			g_curl.easy_setopt(curl, CURLOPT_POSTFIELDSIZE_, (long)bodyBytes);
+		}
+	}
+
+	CURLcode rc = g_curl.easy_perform(curl);
+
+	long status = 0;
+	g_curl.easy_getinfo(curl, CURLINFO_RESPONSE_CODE_, &status);
+	char *effectiveUrl = NULL;
+	g_curl.easy_getinfo(curl, CURLINFO_EFFECTIVE_URL_, &effectiveUrl);
+	double totalTime = 0;
+	g_curl.easy_getinfo(curl, CURLINFO_TOTAL_TIME_, &totalTime);
+
+	// --- assemble the result ----------------------------------------------
+	Map *out = Map::Create();
+	if (!out)
+	{
+		g_curl.easy_cleanup(curl);
+		if (headerList) g_curl.slist_free_all(headerList);
+		aResultToken.MemoryError();
+		return;
+	}
+
+	if (rc != CURLE_OK_)
+	{
+		// A transport failure is reported as an Error plus Status 0, so the
+		// caller can distinguish it from an HTTP-level error status.
+		// libcurl reports errors as ANSI text; widen it for the AHK value.
+		CStringWCharFromUTF8 wMsg(g_curl.easy_strerror(rc));
+		TCHAR err[512];
+		sntprintf(err, _countof(err), _T("%s (curl code %d)")
+			, g_curl.easy_strerror(rc) ? (LPCWSTR)wMsg : _T("request failed"), (int)rc);
+		SetInt(out, _T("Ok"), 0);
+		SetInt(out, _T("Status"), 0);
+		SetStr(out, _T("StatusText"), _T(""));
+		SetStr(out, _T("Error"), err);
+		SetStr(out, _T("Url"), url);
+		SetInt(out, _T("ElapsedMs"), (__int64)(totalTime * 1000));
+		SetObj(out, _T("Headers"), resultHeaders);
+		SetStr(out, _T("Body"), _T(""));
+		SetInt(out, _T("BodyBytes"), 0);
+		g_curl.easy_cleanup(curl);
+		if (headerList) g_curl.slist_free_all(headerList);
+		aResultToken.SetValue(out);
+		return;
+	}
+
+	const char *rawBody = buf.data ? buf.data : "";
+	size_t rawLen = buf.len;
+
+	if (saveTo[0])
+	{
+		HANDLE f = CreateFile(saveTo, GENERIC_WRITE, 0, nullptr, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+		if (f != INVALID_HANDLE_VALUE)
+		{
+			DWORD written = 0;
+			WriteFile(f, rawBody, (DWORD)rawLen, &written, nullptr);
+			CloseHandle(f);
+		}
+	}
+
+	SetInt(out, _T("Status"), status);
+	SetInt(out, _T("Ok"), (status >= 200 && status < 300) ? 1 : 0);
+	SetStr(out, _T("StatusText"), _T(""));
+	CStringWCharFromUTF8 wUrl(effectiveUrl ? effectiveUrl : "");
+	SetStr(out, _T("Url"), (LPCWSTR)wUrl);
+	SetInt(out, _T("ElapsedMs"), (__int64)(totalTime * 1000));
+	SetObj(out, _T("Headers"), resultHeaders);
+	SetInt(out, _T("BodyBytes"), (__int64)rawLen);
+	if (saveTo[0])
+		SetStr(out, _T("SavedTo"), saveTo);
+	else
+	{
+		CStringWCharFromUTF8 wBody(rawBody, (int)rawLen);
+		SetStr(out, _T("Body"), (LPCWSTR)wBody);
+	}
+
+	g_curl.easy_cleanup(curl);
+	if (headerList) g_curl.slist_free_all(headerList);
+
+	aResultToken.SetValue(out);
+}
