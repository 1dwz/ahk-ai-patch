+// ahk-ai patch: /dump-api access to the typed registry.  sMdFunc is
+// file-local, and MdType is an internal enum held in argtype[], so callers
+// need a stable shape and a way to name each type.  See MdTypeToString().
+//
+// A note on the argument types: MdType is UINT8-backed, so a single element is
+// copied out per index instead of handing back a pointer into the array.  A
+// pointer would be read as int and silently pick up three neighbouring
+// elements.
+int Script::MdFuncApiCount()
+{
+	return _countof(sMdFunc);
+}
+
+LPCTSTR Script::MdFuncApiAt(int aIndex, int &aArgCount, int *&aArgTypes, int &aRetType)
+{
+	auto &f = sMdFunc[aIndex];
+	// argtype is a fixed array terminated by MdType::Void; count the real ones
+	// exactly as GetBuiltInMdFunc() does when it constructs the MdFunc.
+	int ac;
+	for (ac = 0; ac < _countof(f.argtype) && f.argtype[ac] != MdType::Void; ++ac);
+	aArgCount = ac;
+	// Widen one element at a time into a reusable buffer, so the caller sees
+	// plain ints and never touches MdType's layout.
+	static int sArgBuf[32];   // >= _countof(MdFuncEntry::argtype)
+	for (int i = 0; i < ac; ++i)
+		sArgBuf[i] = (int)f.argtype[i];
+	aArgTypes = sArgBuf;
+	aRetType = (int)f.rettype;
+	return f.name;
+}
+
+// Name for a single element of MdFuncEntry::argtype.  An element is either a
+// bare type (Void..Params) or a modifier flag (Optional = 0x80, RetVal, Out,
+// ...), which applies to the element that follows it.  This returns just the
+// name of that one element; the caller is responsible for merging a modifier
+// with the type it precedes.
+LPCTSTR Script::MdTypeToString(int aTypeRaw)
+{
+	MdType aType = (MdType)(unsigned char)aTypeRaw;
+	switch (aType)
+	{
+	case MdType::Void:      return _T("Void");
+	case MdType::Int8:      return _T("Int8");
+	case MdType::UInt8:     return _T("UInt8");
+	case MdType::Int16:     return _T("Int16");
+	case MdType::UInt16:    return _T("UInt16");
+	case MdType::Int32:     return _T("Int32");
+	case MdType::UInt32:    return _T("UInt32");
+	case MdType::Int64:     return _T("Int64");
+	case MdType::UInt64:    return _T("UInt64");
+	case MdType::IntPtr:    return _T("IntPtr");
+	// MdType::UIntPtr is a pure alias -- MdType.h defines it as
+	// Exp32or64(UInt32, UInt64) -- so its value is already one of the labels
+	// above on every target (UInt32 on Win32, UInt64 on x64).  Naming it here
+	// would be a duplicate case label, which /WX rejects as C2196.
+	case MdType::Float64:   return _T("Float64");
+	case MdType::Float32:   return _T("Float32");
+	case MdType::String:    return _T("String");
+	case MdType::Object:    return _T("Object");
+	case MdType::Variant:   return _T("Variant");
+	case MdType::Bool32:    return _T("Bool32");
+	case MdType::ResultType:return _T("ResultType");
+	case MdType::FResult:   return _T("FResult");
+	case MdType::Struct:    return _T("Struct");
+	case MdType::Params:    return _T("Params");
+	case MdType::Optional:  return _T("Opt");
+	case MdType::RetVal:    return _T("Ret");
+	case MdType::Out:       return _T("Out");
+	default:
+		{
+			// BitsBase and any type added upstream that this list does not know
+			// about: report the number rather than mislabelling it.
+			static TCHAR sBuf[32];
+			sntprintf(sBuf, _countof(sBuf), _T("MdType(%d)"), (int)aType);
+			return sBuf;
+		}
+	}
+}
